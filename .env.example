# =============================================================================
# Maya AI Concierge — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Required vars will crash the app if missing.
# Optional vars gracefully disable their feature.
# =============================================================================

# --- REQUIRED: Core ---
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=                        # Min 32 chars, run: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ADMIN_API_SECRET=                                # Separate secret for admin endpoints (rate-limit reset). Min 32 chars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                       # Server-only, do NOT expose to client

# --- REQUIRED: Payment (primary) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- OPTIONAL: AI Engine (at least ONE required for AI to work) ---
GEMINI_API_KEY=                                  # Primary AI engine
DEEPSEEK_API_KEY=                                # Fallback #1
OPENAI_API_KEY=                                  # Fallback #2

# --- OPTIONAL: Payments (fallback) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- OPTIONAL: Communications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RESEND_API_KEY=

# --- OPTIONAL: Integrations ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CLOUD_PROJECT=
GBP_API_KEY=
GBP_PUBSUB_VERIFICATION_TOKEN=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_WEBHOOK_SECRET=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=                  # WhatsApp Business phone number ID (from Meta Cloud API)
WHATSAPP_BUSINESS_ACCOUNT_ID=              # WhatsApp Business Account ID

# --- OPTIONAL: Infrastructure ---
UPSTASH_REDIS_REST_URL=                          # For distributed rate limiting + caching
UPSTASH_REDIS_REST_TOKEN=
USE_REDIS=true                                   # Set to 'false' to force in-memory mode
QSTASH_TOKEN=
CRON_SECRET=

# --- OPTIONAL: Security ---
ENCRYPTION_KEY=                                  # AES-256-GCM key for PII at rest (32+ hex chars)
ALLOW_HEADER_BUSINESS_ID=false                   # Set to 'true' to allow x-business-id header override

# --- OPTIONAL: Business defaults ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
BUSINESS_NAME=
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_LOCATION=
BUSINESS_TIMEZONE=America/Chicago

# --- OPTIONAL: Weather ---
OPENWEATHER_API_KEY=
